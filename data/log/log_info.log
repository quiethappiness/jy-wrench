end

-- 检查键是否存在
local exists = redis.call('exists', KEYS[1])
if exists == 0 then
    -- 首次设置：设置值并指定TTL
    redis.call('set', KEYS[1], delta, 'EX', ttl)
    return delta
else
    -- 后续操作：自增并保留原TTL
    return redis.call('incrby', KEYS[1], delta)
end], codec=org.redisson.codec.JsonJacksonCodec], usage=0]
