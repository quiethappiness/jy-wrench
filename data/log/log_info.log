if exists == 0 then
    -- 首次设置：设置值并指定TTL
    redis.call('set', KEYS[1], delta, 'EX', ttl)
    return delta
else
    -- 后续操作：自增并保留原TTL
    return redis.call('incrby', KEYS[1], delta)
